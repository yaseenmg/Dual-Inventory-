#!/bin/sh
# Gradle wrapper launcher for Unix-like systems.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if ! command -v java >/dev/null 2>&1; then
  echo "ERROR: Java was not found. Install Java 17+ and ensure java is on PATH." >&2
  exit 1
fi
if [ ! -f "$CLASSPATH" ]; then
  echo "ERROR: gradle/wrapper/gradle-wrapper.jar is missing." >&2
  echo "The wrapper JAR must be present before ./gradlew can run." >&2
  exit 1
fi
exec java -Xmx64m -Xms64m -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
